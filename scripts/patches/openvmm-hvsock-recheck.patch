+    // Model missing host notifications without registering the host waker in
+    // the real signal. Outbound guest notifications continue to work.
+    struct SuppressedSignal(Box<dyn SignalVmbusChannel>);
+
+    impl SignalVmbusChannel for SuppressedSignal {
+        fn signal_remote(&self) {
+            self.0.signal_remote();
+        }
+
+        fn poll_for_signal(
+            &self,
+            _cx: &mut std::task::Context<'_>,
+        ) -> std::task::Poll<Result<(), ChannelClosed>> {
+            std::task::Poll::Pending
+        }
