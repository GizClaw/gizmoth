+    #[async_test]
+    async fn test_relay_rechecks_missing_notifications_under_backpressure(driver: DefaultDriver) {
+        use std::time::Duration;
+        let (mut host, guest) = vmbus_channel::connected_async_channels(0x6000);
+        host.signal = Box::new(super::RecheckingSignal::new(
+            Box::new(SuppressedSignal(host.signal)),
+            &driver,
+            Duration::from_millis(10),
+        ));
+        let host = BytePipe::new(host).unwrap();
+        let mut guest = BytePipe::new(guest).unwrap();
+        let (socket, relay_socket) = UnixStream::pair().unwrap();
+        let mut socket = PolledSocket::new(&driver, socket).unwrap();
+        let relay_socket = PolledSocket::new(&driver, relay_socket).unwrap();
+        // Separate task: the test's deadline must not repoll the relay itself.
+        let relay = driver.spawn("rechecking relay", async move {
+            relay_connected(host, relay_socket).await.unwrap();
+        });
+        let host_io = async {
+            for round in 0..16u8 {
+                let bytes: Vec<_> = (0..131083).map(|n| (n as u8).wrapping_add(round)).collect();
+                socket.write_all(&bytes).await.unwrap();
+                let mut reply = vec![0; bytes.len()];
+                socket.read_exact(&mut reply).await.unwrap();
+                assert_eq!(reply, bytes);
+            }
+            socket.close().await.unwrap();
+        };
+        let guest_io = async {
+            for round in 0..16u8 {
+                let mut bytes = vec![0; 131083];
+                for part in bytes.chunks_mut(257) {
+                    guest.read_exact(part).await.unwrap();
+                }
+                assert!(
+                    bytes
+                        .iter()
+                        .enumerate()
+                        .all(|(n, &b)| b == (n as u8).wrapping_add(round))
+                );
+                guest.write_all(&bytes).await.unwrap();
+            }
+            guest.close().await.unwrap();
+        };
+        let io = async {
+            futures::future::join(host_io, guest_io).await;
+            relay.await;
+        };
+        let mut timer = pal_async::timer::PolledTimer::new(&driver);
+        let timeout = timer.sleep(Duration::from_secs(20));
+        futures::pin_mut!(io, timeout);
+        assert!(
+            matches!(
+                futures::future::select(io, timeout).await,
+                futures::future::Either::Left(_)
+            ),
+            "relay did not recover from suppressed notifications"
+        );
+    }
