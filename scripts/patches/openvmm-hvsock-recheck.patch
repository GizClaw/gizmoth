+    #[async_test]
+    async fn test_missing_signal_stays_blocked_without_recheck(driver: DefaultDriver) {
+        use std::sync::atomic::{AtomicBool, Ordering};
+        use std::time::Duration;
+        let (mut host, guest) = vmbus_channel::connected_async_channels(0x6000);
+        host.signal = Box::new(SuppressedSignal(host.signal));
+        let mut host = BytePipe::new(host).unwrap();
+        let mut guest = BytePipe::new(guest).unwrap();
+        let started = Arc::new(AtomicBool::new(false));
+        let completed = Arc::new(AtomicBool::new(false));
+        let task = driver.spawn("suppressed read", {
+            let started = started.clone();
+            let completed = completed.clone();
+            async move {
+                let mut bytes = [0; 4];
+                let mut read = host.read_exact(&mut bytes);
+                assert!(futures::poll!(&mut read).is_pending());
+                started.store(true, Ordering::SeqCst);
+                read.await.unwrap();
+                completed.store(true, Ordering::SeqCst);
+            }
+        });
+        let mut timer = pal_async::timer::PolledTimer::new(&driver);
+        let deadline = pal_async::timer::Instant::now() + Duration::from_secs(5);
+        while !started.load(Ordering::SeqCst) {
+            assert!(pal_async::timer::Instant::now() < deadline);
+            timer.sleep(Duration::from_millis(1)).await;
+        }
+        guest.write_all(b"test").await.unwrap();
+        // The timer wakes this task only, never the independently spawned read.
+        timer.sleep(Duration::from_millis(80)).await;
+        assert!(!completed.load(Ordering::SeqCst));
+        drop(task);
+    }
