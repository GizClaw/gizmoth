+// GizMoth's macOS relay must not depend on an unbounded notification wait.
+// A timer is a readiness hint only: BytePipe still checks the ring before IO.
+// Keep it on the channel's existing driver, so cancellation drops the timer
+// with the relay and no extra thread or guest interrupt is required.
+#[cfg(any(target_os = "macos", test))]
+struct RecheckingSignal {
+    inner: Box<dyn vmbus_channel::SignalVmbusChannel>,
+    timer: std::sync::Mutex<(pal_async::timer::PolledTimer, pal_async::timer::Instant)>,
+    interval: Duration,
+}
+
+#[cfg(any(target_os = "macos", test))]
+impl RecheckingSignal {
+    fn new(
+        inner: Box<dyn vmbus_channel::SignalVmbusChannel>,
+        driver: &(impl pal_async::driver::Driver + ?Sized),
+        interval: Duration,
+    ) -> Self {
+        Self {
+            inner,
+            timer: std::sync::Mutex::new((
+                pal_async::timer::PolledTimer::new(driver),
+                pal_async::timer::Instant::now() + interval,
+            )),
+            interval,
+        }
+    }
+}
+
+#[cfg(any(target_os = "macos", test))]
+impl vmbus_channel::SignalVmbusChannel for RecheckingSignal {
+    fn signal_remote(&self) {
+        self.inner.signal_remote();
+    }
+
+    fn poll_for_signal(
+        &self,
+        cx: &mut std::task::Context<'_>,
+    ) -> std::task::Poll<Result<(), vmbus_channel::ChannelClosed>> {
+        // A real signal (including closure) always takes precedence.
+        if let ready @ std::task::Poll::Ready(_) = self.inner.poll_for_signal(cx) {
+            return ready;
+        }
+        let (timer, deadline) = &mut *self.timer.lock().unwrap();
+        match timer.poll_until(cx, *deadline) {
+            std::task::Poll::Ready(now) => {
+                *deadline = now + self.interval;
+                std::task::Poll::Ready(Ok(()))
+            }
+            std::task::Poll::Pending => std::task::Poll::Pending,
+        }
+    }
+}
+
+#[cfg(target_os = "macos")]
+fn rechecking_channel<M: RingMem>(
+    mut channel: vmbus_channel::RawAsyncChannel<M>,
+    driver: &(impl pal_async::driver::Driver + ?Sized),
+) -> vmbus_channel::RawAsyncChannel<M> {
+    channel.signal = Box::new(RecheckingSignal::new(
+        channel.signal,
+        driver,
+        Duration::from_secs(1),
+    ));
+    channel
+}
