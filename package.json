{
  "name": "gizmoth",
  "version": "0.1.11",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "postinstall": "patch-package --error-on-fail",
    "predev": "node scripts/bundle-gizos-docs.mjs",
    "dev": "vite --host 127.0.0.1",
    "prebuild": "node scripts/bundle-gizos-docs.mjs",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "test:browser": "node --test test/browser/agent-popup.test.mjs",
    "test:tauri": "node scripts/test-tauri.mjs",
    "test:tauri:run": "node scripts/test-tauri.mjs --no-build",
    "mcp:gizos-docs": "node --experimental-strip-types scripts/gizos-docs-mcp.mjs",
    "docs:gizos:update": "node scripts/update-gizos-docs.mjs",
    "docs:gizos:bundle": "node scripts/bundle-gizos-docs.mjs",
    "format": "prettier --write src test",
    "tauri": "tauri",
    "app": "tauri dev",
    "app:build": "tauri build",
    "serial-core:build": "node scripts/build-serial-core.mjs"
  },
  "dependencies": {
    "@cfworker/json-schema": "4.1.1",
    "@codemirror/lang-css": "6.3.1",
    "@codemirror/lang-html": "6.4.12",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/language": "^6.11.0",
    "@codemirror/legacy-modes": "^6.5.1",
    "@codemirror/search": "6.7.2",
    "@codemirror/view": "^6.38.0",
    "@earendil-works/pi-agent-core": "1.5.0",
    "@earendil-works/pi-ai": "1.5.0",
    "@earendil-works/pi-schema": "1.5.0",
    "@gizclaw/models-player": "0.7.0",
    "@idy/magpie-design-system": "file:vendor/idy-magpie-design-system-0.4.3.tgz",
    "@idy/peetty": "file:vendor/idy-peetty-0.2.0.tgz",
    "@johnnymorganz/stylua": "2.6.0",
    "@lezer/highlight": "1.2.5",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@phosphor-icons/react": "2.1.10",
    "@tauri-apps/api": "2.12.4",
    "@tauri-apps/plugin-http": "2.8.3",
    "@tauri-apps/plugin-opener": "2.7.2",
    "@tauri-apps/plugin-process": "2.4.0",
    "@tauri-apps/plugin-updater": "2.14.1",
    "@uiw/react-codemirror": "4.25.12",
    "prettier": "3.9.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.4",
    "@types/node": "^24.0.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "patch-package": "8.0.1",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "webdriverio": "9.33.1"
  }
}
