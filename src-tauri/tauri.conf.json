{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GizMoth",
  "version": "0.3.3",
  "identifier": "com.gizclaw.gizmoth",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "GizMoth",
        "width": 1200,
        "height": 780,
        "minWidth": 1000,
        "minHeight": 680,
        "resizable": true,
        "maximizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src ipc: http://ipc.localhost https://static-volc.gizclaw.com blob: data:; object-src 'none'; base-uri 'none'; frame-src 'none'"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQ3QzU1MkVFMTA2OTUyM0YKUldRL1Vta1E3bExGUjIxQXZrMHZPUERnU3VnbGZuaVl1TkkwWGg3ZU5zQ3JSaENGWEFMNFpxaEQK",
      "endpoints": ["https://github.com/GizClaw/gizmoth/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["app", "dmg", "nsis"],
    "resources": { "../docs/gizos/": "gizos-docs/" },
    "category": "DeveloperTool",
    "shortDescription": "Pair, control and program GizOS devices",
    "copyright": "Copyright © 2026 GizClaw contributors. MIT License.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "macOS": { "minimumSystemVersion": "12.0", "infoPlist": "Info.plist", "hardenedRuntime": true },
    "windows": { "nsis": { "installMode": "currentUser" } }
  }
}
